# Shared native, Docker and CI entry point. Run from any working directory.
cmake_minimum_required(VERSION 3.25)
get_filename_component(source "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED SUITE)
    set(SUITE quick)
endif()
if(NOT SUITE MATCHES "^(quick|article|full)$")
    message(FATAL_ERROR "SUITE must be quick, article or full")
endif()
if(NOT DEFINED JOBS)
    set(JOBS 2)
endif()
if(NOT JOBS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "JOBS must be a positive integer")
endif()
if(NOT DEFINED BUILD_DIR)
    set(BUILD_DIR "${source}/build/contributor-${SUITE}")
endif()
get_filename_component(BUILD_DIR "${BUILD_DIR}" ABSOLUTE)
if(BUILD_DIR STREQUAL source)
    message(FATAL_ERROR "Use a separate BUILD_DIR, not the source directory")
endif()
set(article OFF)
if(NOT SUITE STREQUAL "quick")
    set(article ON)
endif()
set(compiler)
if(DEFINED CXX)
    list(APPEND compiler "-DCMAKE_CXX_COMPILER=${CXX}")
endif()
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Command failed (${result}): ${ARGV}")
    endif()
endfunction()
message(STATUS "Contributor suite: ${SUITE}; article data: ${article}; workers: ${JOBS}")
run("${CMAKE_COMMAND}" -S "${source}" -B "${BUILD_DIR}" -G Ninja
    -DCMAKE_BUILD_TYPE=Release -DMODEM_WERROR=ON -DMODEM_BUILD_TESTS=ON
    "-DMODEM_ARTICLE_DATA=${article}" ${compiler})
run("${CMAKE_COMMAND}" --build "${BUILD_DIR}" --parallel "${JOBS}")
set(selection)
if(SUITE STREQUAL "quick")
    list(APPEND selection -LE "^(long|report)$")
elseif(SUITE STREQUAL "article")
    list(APPEND selection -L "^first-path$")
endif()
run("${CMAKE_CTEST_COMMAND}" --test-dir "${BUILD_DIR}" --build-config Release
    --output-on-failure --no-tests=error --parallel "${JOBS}" ${selection})
