# The article recordings: a package of WAV files the articles' demos and tests run on,
# published as a release asset of the public repository, never committed. Git carries the
# package's pack.json (where the archive is, its size and SHA-256, the SHA-256 of its
# cases.json) and the cases.json itself.
#
# modem_article_pack(<pack.json directory> <data directory>) makes <data directory>/<root>/ a
# verified copy of the package pack.json names: it reuses one that is already there and passes the
# checks, and otherwise downloads the archive (kept beside it, so a removed package unpacks
# again without the network), checks its size and hash, unpacks it and checks it before it
# takes the package's name. A package that is there but fails a check is a configure error
# that says how to fetch it afresh; nothing is overwritten. One configure at a time may
# populate a data directory.

# The checks on an unpacked package: its VERSION, its cases.json against pack.json, and its
# inventory (INDEX.sha256: every other file, each with its SHA-256, and no file it does not
# list). Sets <result> to an empty string when the package passes, or to why it does not.
function(modem_check_article_pack directory package_id cases_sha256 result)
    set(${result} "" PARENT_SCOPE)
    if(NOT EXISTS "${directory}/VERSION")
        set(${result} "it has no VERSION file" PARENT_SCOPE)
        return()
    endif()
    file(READ "${directory}/VERSION" version)
    if(NOT version STREQUAL "${package_id}\n")
        set(${result} "its VERSION does not read ${package_id}" PARENT_SCOPE)
        return()
    endif()
    if(NOT EXISTS "${directory}/cases.json")
        set(${result} "it has no cases.json" PARENT_SCOPE)
        return()
    endif()
    file(SHA256 "${directory}/cases.json" hash)
    if(NOT hash STREQUAL "${cases_sha256}")
        set(${result} "its cases.json is not the one pack.json names" PARENT_SCOPE)
        return()
    endif()
    if(NOT EXISTS "${directory}/INDEX.sha256")
        set(${result} "it has no INDEX.sha256" PARENT_SCOPE)
        return()
    endif()
    file(STRINGS "${directory}/INDEX.sha256" entries)
    set(listed_paths)
    foreach(entry IN LISTS entries)
        if(NOT entry MATCHES "^([0-9a-f]+)  ([A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*)$")
            set(${result} "INDEX.sha256 has a line that is not \"<SHA-256>  <relative path>\": ${entry}" PARENT_SCOPE)
            return()
        endif()
        set(expected "${CMAKE_MATCH_1}")
        set(path "${CMAKE_MATCH_2}")
        if(path IN_LIST listed_paths)
            set(${result} "INDEX.sha256 lists ${path} more than once" PARENT_SCOPE)
            return()
        endif()
        list(APPEND listed_paths "${path}")
        string(LENGTH "${expected}" length)
        if(NOT length EQUAL 64 OR path MATCHES "(^|/)\\.\\.?(/|$)" OR path STREQUAL "INDEX.sha256")
            set(${result} "INDEX.sha256 has an entry it may not have: ${entry}" PARENT_SCOPE)
            return()
        endif()
        if(IS_SYMLINK "${directory}/${path}" OR IS_DIRECTORY "${directory}/${path}" OR NOT EXISTS "${directory}/${path}")
            set(${result} "${path}, listed in INDEX.sha256, is missing or not a file" PARENT_SCOPE)
            return()
        endif()
        file(SHA256 "${directory}/${path}" hash)
        if(NOT hash STREQUAL "${expected}")
            set(${result} "${path} does not match its SHA-256 in INDEX.sha256" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    list(LENGTH listed_paths listed)
    file(GLOB_RECURSE files LIST_DIRECTORIES false "${directory}/*")
    list(LENGTH files present)
    math(EXPR present "${present} - 1")
    if(NOT present EQUAL listed)
        set(${result} "it holds ${present} files besides INDEX.sha256, and INDEX.sha256 lists ${listed}" PARENT_SCOPE)
    endif()
endfunction()

function(modem_article_pack record_directory data_directory)
    file(READ "${record_directory}/pack.json" record)
    string(JSON schema ERROR_VARIABLE error GET "${record}" schema)
    if(error OR NOT schema STREQUAL "modem.article-pack-release/1")
        message(FATAL_ERROR "${record_directory}/pack.json: not a modem.article-pack-release/1 record")
    endif()
    foreach(field package_id url archive_bytes archive_sha256 root cases_schema cases_sha256)
        string(JSON ${field} ERROR_VARIABLE error GET "${record}" ${field})
        if(error)
            message(FATAL_ERROR "${record_directory}/pack.json: ${error}")
        endif()
    endforeach()
    # Validate path components before using them in filesystem operations.
    if(NOT root MATCHES "^[A-Za-z0-9][A-Za-z0-9_-]*$" OR NOT root STREQUAL package_id)
        message(FATAL_ERROR "pack.json: root must be a simple package_id directory name")
    endif()
    foreach(digest archive_sha256 cases_sha256)
        string(LENGTH "${${digest}}" length)
        if(NOT length EQUAL 64 OR NOT "${${digest}}" MATCHES "^[0-9a-f]+$")
            message(FATAL_ERROR "pack.json: ${digest} must be a lowercase SHA-256")
        endif()
    endforeach()
    if(NOT archive_bytes MATCHES "^[1-9][0-9]*$" OR NOT url MATCHES "^https://")
        message(FATAL_ERROR "pack.json: expected a positive archive size and HTTPS URL")
    endif()
    if(NOT cases_schema STREQUAL "modem.first-path-cases/1")
        message(FATAL_ERROR "${record_directory}/pack.json: the cases schema ${cases_schema} is not one this build reads")
    endif()
    file(SHA256 "${record_directory}/cases.json" hash)
    if(NOT hash STREQUAL "${cases_sha256}")
        message(FATAL_ERROR "${record_directory}/cases.json is not the one pack.json names")
    endif()

    set(package "${data_directory}/${root}")
    set(refetch "Remove ${package} and configure again to fetch ${package_id} afresh, or unpack the release asset there by hand (${record_directory}/README.md).")
    if(EXISTS "${package}")
        modem_check_article_pack("${package}" "${package_id}" "${cases_sha256}" problem)
        if(problem)
            message(FATAL_ERROR "The article recordings in ${package} are not usable: ${problem}. ${refetch}")
        endif()
        message(STATUS "Article recordings: ${package} (${package_id}, verified)")
        return()
    endif()

    get_filename_component(asset "${url}" NAME)
    file(MAKE_DIRECTORY "${data_directory}")
    set(archive "${data_directory}/${asset}")
    # An archive already there with the hash in pack.json is used as it is. A failed download or a
    # hash mismatch stops the configure with CMake's own message, and the next configure
    # downloads again.
    message(STATUS "Article recordings: fetching ${url}")
    file(DOWNLOAD "${url}" "${archive}" EXPECTED_HASH SHA256=${archive_sha256} TLS_VERIFY ON)
    file(SIZE "${archive}" bytes)
    if(NOT bytes EQUAL "${archive_bytes}")
        message(FATAL_ERROR "Article recordings: ${archive} has ${bytes} bytes, not the ${archive_bytes} in pack.json. Remove it and configure again.")
    endif()

    set(staging "${data_directory}/.${root}.unpacking")
    file(REMOVE_RECURSE "${staging}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${staging}")
    file(GLOB top RELATIVE "${staging}" LIST_DIRECTORIES true "${staging}/*" "${staging}/.*")
    if(NOT top STREQUAL "${root}")
        file(REMOVE_RECURSE "${staging}")
        message(FATAL_ERROR "Article recordings: ${archive} does not hold the one folder ${root}.")
    endif()
    modem_check_article_pack("${staging}/${root}" "${package_id}" "${cases_sha256}" problem)
    if(problem)
        file(REMOVE_RECURSE "${staging}")
        message(FATAL_ERROR "Article recordings: the package in ${archive} is not usable: ${problem}.")
    endif()
    file(RENAME "${staging}/${root}" "${package}")
    file(REMOVE_RECURSE "${staging}")
    message(STATUS "Article recordings: ${package} (${package_id}, fetched and verified)")
endfunction()
