# Synthetic metadata only; no recordings are generated by this test.
cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/ArticleData.cmake")
if(NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "TEST_DIR is required")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}")
file(WRITE "${TEST_DIR}/VERSION" "fixture-v1\n")
file(WRITE "${TEST_DIR}/cases.json" "{}\n")
file(SHA256 "${TEST_DIR}/VERSION" version_hash)
file(SHA256 "${TEST_DIR}/cases.json" cases_hash)
set(inventory "${version_hash}  VERSION\n${cases_hash}  cases.json\n")
function(check expect_error)
    modem_check_article_pack("${TEST_DIR}" fixture-v1 "${cases_hash}" problem)
    if(expect_error AND NOT problem)
        message(FATAL_ERROR "Invalid package accepted")
    elseif(NOT expect_error AND problem)
        message(FATAL_ERROR "Valid package rejected: ${problem}")
    endif()
endfunction()
file(WRITE "${TEST_DIR}/INDEX.sha256" "${inventory}")
check(FALSE)
file(WRITE "${TEST_DIR}/cases.json" "corrupt\n")
check(TRUE)
file(WRITE "${TEST_DIR}/cases.json" "{}\n")
file(WRITE "${TEST_DIR}/extra.txt" "unlisted\n")
# Previously a duplicate VERSION line could conceal an unlisted file by count.
file(WRITE "${TEST_DIR}/INDEX.sha256" "${inventory}${version_hash}  VERSION\n")
check(TRUE)
file(WRITE "${TEST_DIR}/INDEX.sha256" "${inventory}")
check(TRUE)
file(REMOVE "${TEST_DIR}/extra.txt")
file(WRITE "${TEST_DIR}/INDEX.sha256" "${inventory}${version_hash}  ../VERSION\n")
check(TRUE)
file(WRITE "${TEST_DIR}/INDEX.sha256" "${inventory}")
file(REMOVE "${TEST_DIR}/VERSION")
check(TRUE)
file(WRITE "${TEST_DIR}/VERSION" "fixture-v2\n")
check(TRUE)
file(WRITE "${TEST_DIR}/VERSION" "fixture-v1\n")
check(FALSE)
file(REMOVE "${TEST_DIR}/INDEX.sha256")
check(TRUE)
file(WRITE "${TEST_DIR}/INDEX.sha256" "${inventory}")
check(FALSE)
message(STATUS "Article pack validation: valid, corrupt, missing, version, inventory and traversal checks passed")
